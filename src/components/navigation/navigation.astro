---
import { Image } from "astro:assets";
import css from "./navigation.module.css";
import logo from "../../../public/logo.svg";
---

<div class={css.nav} data-topscroll>
	<div class={css.nav__logo}>
		<p class={css.nav__title}>
			<Image src={logo} alt="Логотип в виде клевера" width={40} />
			<span class={css.nav__logo_green}>ЭКО</span>
			<span class={css.nav__logo_blue}>ДВ</span>ПРОЕКТ
			<span class={css.nav__logo_normal}>групп</span>
		</p>
	</div>
	<nav class={css.nav__burger}>
		<ul class={css.nav__list} id="nav-list">
			<li><a href="#about" data-scrollto="#about">Компания</a></li>
			<li><a href="#partners" data-scrollto="#partners">Партнеры</a></li>
			<li><a href="#contacts" data-scrollto="#contacts">Контакты</a></li>
		</ul>
		<button class={css.burger} id="burger-menu">
			<Image src="/burger.svg" width="35" height="35" alt="Меню" />
		</button>
	</nav>
</div>

<script>
	document.addEventListener("astro:page-load", () => {
		let navList = document.querySelector("#nav-list") as HTMLElement;
		let burgerMenu = document.querySelector("#burger-menu") as HTMLElement;

		function onFocus() {
			navList.style.transform = "translateY(0%)";
		}

		function onBlur() {
			navList.style.transform = "";
		}

		navList = document.querySelector("#nav-list") as HTMLElement;
		burgerMenu = document.querySelector("#burger-menu") as HTMLElement;

		burgerMenu.addEventListener("focus", onFocus);
		burgerMenu.addEventListener("blur", onBlur);
	});
</script>
