---
import css from "./more-services.module.css";
import ServiceCard from "./service-card/service-card.astro";

import { MORE_SERVICE_CARDS } from "./more-services.constants";
---

<section class={css["more-services"]}>
	{
		MORE_SERVICE_CARDS.map((el) => (
			<ServiceCard title={el.title} order={el.order} src={el.src}>
				{el.content}
			</ServiceCard>
		))
	}
</section>
