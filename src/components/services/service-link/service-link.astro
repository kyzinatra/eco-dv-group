---
import { Image } from "astro:assets";
import css from "./service-link.module.css";
interface Props {
	src: ImageMetadata;
	title: string;
	to: string;
	alt?: string;
	id: number;
}

const { src, title, to, alt = "", id } = Astro.props;
---

<a href={to} class={css.link}>
	<Image src={src} alt={alt} data-hoverscale transition:name={"card-" + id} />
	<h4 class={css.link__title}>{title}</h4>
</a>
