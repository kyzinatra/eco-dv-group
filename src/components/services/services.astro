---
import ServiceLink from "./service-link/service-link.astro";
import { SERVICE_LINKS } from "./services.constants";

import css from "./services.module.css";
---

<section class={css.services}>
	{SERVICE_LINKS.map((el, i) => <ServiceLink title={el.title} src={el.src} to={el.to} id={i + 1} />)}
</section>
