---
interface Props {
	align?: "left" | "center" | "right";
	id?: string;
	isHead?: boolean;
}
import css from "./divider.module.css";
const { align = "left", id, isHead = true } = Astro.props;
---

<div class={css.divider} style={{ justifyContent: align }} id={id}>
	{
		isHead ? (
			<h2 class={css.divider__title}>
				<slot />
			</h2>
		) : (
			<div class={css.divider__title}>
				<slot />
			</div>
		)
	}
</div>
