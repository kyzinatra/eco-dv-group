---
import Partner from "./partner/partner.astro";
import { PARTNERS_LINKS } from "./partners.constants";
---

<section class="glide">
	<div class="glide__track" data-glide-el="track">
		<div class="glide__slides">
			{
				PARTNERS_LINKS.map((el) => (
					<div class="glide__slide">
						<Partner src={el} alt="" />
					</div>
				))
			}
		</div>
	</div>
</section>

<style>
	.glide__slides {
		display: flex;
		align-items: center;
		justify-content: center;
	}

	.glide__slide {
		display: flex;
		justify-content: center;
	}
</style>
<script src="./slider.ts"></script>
