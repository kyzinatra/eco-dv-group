---
import AboutCard from "./about-card/about-card.astro";
import { aboutCards } from "./about.constants";
import css from "./about.module.css";
---

<div class={css.about}>
	{
		aboutCards.map((el) =>
			el.content ? (
				<AboutCard src={el.src} className={el.className} alt="">
					{el.content}
				</AboutCard>
			) : (
				<AboutCard src={el.src} className={el.className} alt="" />
			)
		)
	}
</div>
