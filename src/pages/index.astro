---
import About from "../components/about/about.astro";
import Contacts from "../components/contacts/contacts.astro";
import AboutCover from "../components/covers/about-cover/about-cover.astro";
import ServicesCover from "../components/covers/services-cover/services-cover.astro";
import Divider from "../components/divider/divider.astro";
import Footer from "../components/footer/footer.astro";
import Header from "../components/header/header.astro";
import Partners from "../components/partners/partners.astro";
import MoreServices from "../components/services/more-services.astro";
import Services from "../components/services/services.astro";
import Layout from "../layouts/Layout.astro";
---

<Layout title="ЭКОДВПРОЕКТ групп">
	<Header />
	<main>
		<Divider align="center">Тут текст</Divider>
		<AboutCover />
		<Divider id="about">О нас</Divider>
		<About />
		<Divider>Услуги</Divider>
		<ServicesCover />
		<Services />
		<Divider>Другие наши услуги</Divider>
		<MoreServices />
		<Divider id="partners">Партнеры</Divider>
		<Partners />
		<Divider id="contacts">Контакты</Divider>
		<Contacts />
	</main>
	<Footer />
</Layout>
