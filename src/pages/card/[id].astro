---
import type { GetStaticPaths } from "astro";
import Layout from "../../layouts/Layout.astro";
import ServiceFullCard from "../../components/services/service-full-card/service-full-card.astro";
import { CARDS } from "./card.constants";

export const getStaticPaths = (async () => {
	return CARDS.map((el) => ({ params: { id: el.id }, props: { ...el } }));
}) satisfies GetStaticPaths;

const { image, description, title, list, id } = Astro.props;
---

<Layout title="Карочка">
	<ServiceFullCard src={image} description={description} title={title} list={list} id={id} />
</Layout>
