---
import { ViewTransitions } from "astro:transitions";
import "../style/index.css";
import "@glidejs/glide/dist/css/glide.core.min.css";

interface Props {
	title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="ru">
	<head>
		<meta charset="UTF-8" />
		<!-- HTML Meta Tags -->
		<title>{title}</title>

		<meta
			name="description"
			content="Мы предоставляем услуги экологического проектирования, инженерных изысканий, экологического аудита и консалтинга в соответствии с потребностями и желаниями Заказчика по целому ряду направлений."
		/>

		<!-- Facebook Meta Tags -->
		<meta property="og:type" content="website" />
		<meta property="og:title" content="ЭКОДВПРОЕКТ групп" />
		<meta
			property="og:description"
			content="Мы предоставляем услуги экологического проектирования, инженерных изысканий, экологического аудита и консалтинга в соответствии с потребностями и желаниями Заказчика по целому ряду направлений."
		/>
		<meta property="og:image" content="/ogimg.png" />

		<!-- Twitter Meta Tags -->
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content="ЭКОДВПРОЕКТ групп" />
		<meta
			name="twitter:description"
			content="Мы предоставляем услуги экологического проектирования, инженерных изысканий, экологического аудита и консалтинга в соответствии с потребностями и желаниями Заказчика по целому ряду направлений."
		/>
		<meta name="twitter:image" content="/ogimg.png" />

		<link rel="sitemap" href="/sitemap-index.xml" />
		<meta name="yandex-verification" content="74bb53a1e6f3c9e1" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/svg+xml" href="/logo.svg" />
		<script src="./navigation.ts"></script>
		<script src="./paralax.ts"></script>
		<script src="./scroll.ts"></script>
	</head>

	<body>
		<ViewTransitions />
		<slot />
	</body>
</html>
